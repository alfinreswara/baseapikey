# ==============================================================================
# BaseAPIKey Environment Variables Template
# Copy this file to .env for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Runtime Node environment (development | staging | production | test)
NODE_ENV=development

# Server port and host settings for Gateway API
PORT=3000
HOST=0.0.0.0

# Keep false when directly exposed. Behind a trusted proxy, use a trusted proxy CIDR list.
TRUST_PROXY=false

# CORS allowed origins and maximum payload request size in bytes
CORS_ORIGIN=*
MAX_REQUEST_SIZE=1048576

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# PostgreSQL connection string and pool size for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baseapikey
DATABASE_POOL_SIZE=5

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Redis 7+)
# ------------------------------------------------------------------------------
# Redis connection URL for rate limiting, caching, and session storage
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
USAGE_QUEUE_BATCH_SIZE=50
USAGE_QUEUE_INTERVAL_MS=250

# Login protection (sliding window, enforced per email and source IP)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Maximum duration for each readiness dependency probe
HEALTH_CHECK_TIMEOUT_MS=5000

# Public model catalog cache lifetime in seconds
MODEL_CATALOG_CACHE_TTL_SECONDS=300
PROVIDER_HEALTH_CHECK_INTERVAL_MS=60000
METRICS_TOKEN=replace_with_a_random_metrics_token_at_least_32_chars
# Local development defaults. Both public URLs must use HTTPS when NODE_ENV=production.
DASHBOARD_PUBLIC_URL=http://localhost:3001
GATEWAY_PUBLIC_URL=http://localhost:3000
DASHBOARD_PORT=3001
ERROR_REPORTING_WEBHOOK_URL=https://errors.example.com/events
ERROR_REPORTING_WEBHOOK_SECRET=replace_with_a_random_reporting_secret_at_least_32_chars

# One-time account token lifetimes and outbound email delivery webhook.
# Production startup requires an HTTPS webhook URL and a secret of at least 32 characters.
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
ACCOUNT_EMAIL_WEBHOOK_URL=https://mailer.example.com/account-events
ACCOUNT_EMAIL_WEBHOOK_SECRET=replace_with_a_random_webhook_secret_at_least_32_chars
ACCOUNT_EMAIL_WEBHOOK_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. Authentication Configuration
# ------------------------------------------------------------------------------
# JWT access and refresh token secrets and expiration settings. The Dashboard
# keeps refresh tokens in an HttpOnly cookie and never exposes them to JavaScript.
JWT_ACCESS_SECRET=super_secret_jwt_access_key_32chars_min_change_me
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_32chars_min_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. AI Provider Configuration
# ------------------------------------------------------------------------------
# 9Router AI provider API key
NINE_ROUTER_API_KEY=nr_live_example_key_change_me
NINE_ROUTER_BASE_URL=https://api.9router.com/v1

# Admin-managed provider credentials use AES-256-GCM. Generate with:
# openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Payment provider adapter and signed credit-purchase webhooks
BILLING_PROVIDER_NAME=payment-provider
BILLING_PROVIDER_URL=https://payments.example.com/api
BILLING_PROVIDER_API_KEY=replace_with_payment_provider_api_key
BILLING_PROVIDER_TIMEOUT_MS=10000
BILLING_WEBHOOK_SECRET=replace_with_a_unique_billing_webhook_secret_at_least_32_chars

# ------------------------------------------------------------------------------
# 6. Logging Configuration
# ------------------------------------------------------------------------------
# Minimum log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=debug
